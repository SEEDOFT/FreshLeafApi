    "paths": {
        "/addresses": {
            "get": {
                "tags": [
                    "Addresses"
                ],
                "summary": "Display a listing of the user's addresses",
                "operationId": "b45d2c4a1f6dadd50c36e33068247d69",
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Addresses"
                ],
                "summary": "Store a newly created address",
                "operationId": "3a5f6184bd7b1a6d9c1d1f65cccf83d8",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "label",
                                    "recipient_name",
                                    "phone",
                                    "address_line_1",
                                    "city",
                                    "province",
                                    "postal_code"
                                ],
                                "properties": {
                                    "label": {
                                        "type": "string",
                                        "example": "Home"
                                    },
                                    "recipient_name": {
                                        "type": "string",
                                        "example": "John Doe"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "example": "1234567890"
                                    },
                                    "address_line_1": {
                                        "type": "string",
                                        "example": "123 Main St"
                                    },
                                    "address_line_2": {
                                        "type": "string",
                                        "example": "Apt 4B",
                                        "nullable": true
                                    },
                                    "city": {
                                        "type": "string",
                                        "example": "New York"
                                    },
                                    "province": {
                                        "type": "string",
                                        "example": "NY"
                                    },
                                    "postal_code": {
                                        "type": "string",
                                        "example": "10001"
                                    },
                                    "lat": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 40.7128,
                                        "nullable": true
                                    },
                                    "long": {
                                        "type": "number",
                                        "format": "float",
                                        "example": -74.006,
                                        "nullable": true
                                    },
                                    "address_map": {
                                        "type": "string",
                                        "example": "https://maps.google.com/...",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Address created successfully"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
